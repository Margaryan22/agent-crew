{
  "name": "agent-crew",
  "displayName": "Agent Crew",
  "description": "A crew of AI agents that builds small-business web apps inside Claude Code, on your own Claude subscription — interview, brief, architecture, tests, reviewed code — with a live view of tasks, questions and spend.",
  "version": "0.3.0",
  "publisher": "whysargis",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#1B1F2A",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Margaryan22/agent-crew.git",
    "directory": "extension"
  },
  "bugs": {
    "url": "https://github.com/Margaryan22/agent-crew/issues"
  },
  "homepage": "https://github.com/Margaryan22/agent-crew/tree/main/extension#readme",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "agents",
    "multi-agent",
    "ai",
    "team",
    "crew",
    "claude code",
    "project generator",
    "tanstack",
    "freelance",
    "small business"
  ],
  "pricing": "Free",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Agent Crew starts AI agents (through Claude Code) that edit files and run commands in your workspace, so it only works in trusted workspaces."
    },
    "virtualWorkspaces": false
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.crew/**"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "crew",
          "title": "Agent Crew",
          "icon": "resources/crew.svg"
        }
      ]
    },
    "views": {
      "crew": [
        {
          "id": "crew.project",
          "name": "Project"
        },
        {
          "id": "crew.tasks",
          "name": "Tasks"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "crew.project",
        "when": "workbenchState == empty",
        "contents": "Agent Crew builds a small-business web app with a team of AI agents — PM, critic, architect, QA, developers and a security reviewer — inside Claude Code, on your own Claude subscription.\nOpen an empty folder for the new project.\n[Open Folder](command:vscode.openFolder)"
      },
      {
        "view": "crew.project",
        "when": "workbenchState != empty && !crew.claudeCodeInstalled",
        "contents": "Agent Crew runs inside Claude Code, on your own Claude subscription. Install the Claude Code extension and sign in first.\n[Install Claude Code](command:crew.installClaudeCode)\nThen install the Agent Crew plugin into it.\n[Install Plugin](command:crew.installPlugin)"
      },
      {
        "view": "crew.project",
        "when": "workbenchState != empty && crew.claudeCodeInstalled && !crew.hasProject",
        "contents": "Describe the tool you need; the crew interviews you, writes a brief, designs, tests and builds it, and asks you only when it must.\n[New Project](command:crew.newProject)\nAlready have a crew-built project here?\n[Add Feature](command:crew.feature)\nFirst time? [Install the plugin](command:crew.installPlugin) · [Check setup](command:crew.checkSetup)"
      },
      {
        "view": "crew.tasks",
        "contents": "No tasks yet. The crew plans them after the brief and the architecture are done."
      }
    ],
    "commands": [
      {
        "command": "crew.newProject",
        "title": "New Project",
        "category": "Agent Crew",
        "icon": "$(add)"
      },
      {
        "command": "crew.feature",
        "title": "Add Feature",
        "category": "Agent Crew",
        "icon": "$(git-branch)"
      },
      {
        "command": "crew.continue",
        "title": "Continue in Claude Code",
        "category": "Agent Crew",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "crew.status",
        "title": "Show Status",
        "category": "Agent Crew"
      },
      {
        "command": "crew.answerEscalation",
        "title": "Answer the Crew’s Question",
        "category": "Agent Crew",
        "icon": "$(reply)"
      },
      {
        "command": "crew.installClaudeCode",
        "title": "Install Claude Code",
        "category": "Agent Crew"
      },
      {
        "command": "crew.installPlugin",
        "title": "Install Plugin into Claude Code",
        "category": "Agent Crew"
      },
      {
        "command": "crew.checkSetup",
        "title": "Check Setup",
        "category": "Agent Crew"
      },
      {
        "command": "crew.openBrief",
        "title": "Open Brief",
        "category": "Agent Crew"
      },
      {
        "command": "crew.openStatus",
        "title": "Open Status File",
        "category": "Agent Crew"
      },
      {
        "command": "crew.openReport",
        "title": "Open Report",
        "category": "Agent Crew"
      },
      {
        "command": "crew.openAccessChecklist",
        "title": "Open Access Checklist",
        "category": "Agent Crew"
      },
      {
        "command": "crew.openTask",
        "title": "Open Task",
        "category": "Agent Crew"
      },
      {
        "command": "crew.showTaskDiff",
        "title": "Show Diff",
        "category": "Agent Crew",
        "icon": "$(diff)"
      },
      {
        "command": "crew.refresh",
        "title": "Refresh",
        "category": "Agent Crew",
        "icon": "$(refresh)"
      },
      {
        "command": "crew.showOutput",
        "title": "Show Log",
        "category": "Agent Crew"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "crew.openTask",
          "when": "false"
        },
        {
          "command": "crew.showTaskDiff",
          "when": "false"
        },
        {
          "command": "crew.continue",
          "when": "crew.hasSession"
        }
      ],
      "view/title": [
        {
          "command": "crew.newProject",
          "when": "view == crew.project && !crew.hasProject",
          "group": "navigation@1"
        },
        {
          "command": "crew.feature",
          "when": "view == crew.project && crew.hasProject",
          "group": "navigation@2"
        },
        {
          "command": "crew.continue",
          "when": "view == crew.project && crew.hasSession",
          "group": "navigation@3"
        },
        {
          "command": "crew.refresh",
          "when": "view == crew.project || view == crew.tasks",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "crew.answerEscalation",
          "when": "view == crew.project && viewItem == crewEscalation",
          "group": "inline"
        },
        {
          "command": "crew.showTaskDiff",
          "when": "view == crew.tasks && viewItem == crewTask",
          "group": "inline"
        },
        {
          "command": "crew.showTaskDiff",
          "when": "view == crew.tasks && viewItem == crewTask",
          "group": "navigation@1"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "crew.gettingStarted",
        "title": "Get started with Agent Crew",
        "description": "Set up Claude Code and the Agent Crew plugin, check your tools, and start your first project.",
        "steps": [
          {
            "id": "crew.walkthrough.claudeCode",
            "title": "Install Claude Code and sign in",
            "description": "The crew runs inside the official Claude Code extension, on your own Claude subscription (or API key). Agent Crew never sees your credentials.\n[Install Claude Code](command:crew.installClaudeCode)",
            "media": {
              "markdown": "resources/walkthrough/claude-code.md"
            },
            "completionEvents": [
              "onContext:crew.claudeCodeInstalled"
            ]
          },
          {
            "id": "crew.walkthrough.plugin",
            "title": "Install the Agent Crew plugin",
            "description": "Claude Code opens its plugin dialog; confirm the install there. You need to do this once.\n[Install Plugin](command:crew.installPlugin)",
            "media": {
              "markdown": "resources/walkthrough/plugin.md"
            },
            "completionEvents": [
              "onContext:crew.pluginInstalled",
              "onCommand:crew.installPlugin"
            ]
          },
          {
            "id": "crew.walkthrough.tools",
            "title": "Check Node.js, git and Docker",
            "description": "Generated projects are TanStack Start apps with PostgreSQL in Docker.\n[Check Setup](command:crew.checkSetup)",
            "media": {
              "markdown": "resources/walkthrough/tools.md"
            },
            "completionEvents": [
              "onContext:crew.toolsOk"
            ]
          },
          {
            "id": "crew.walkthrough.project",
            "title": "Start a project",
            "description": "Open an empty folder, describe the tool you need, press Enter in Claude Code — then answer the interview.\n[New Project](command:crew.newProject)",
            "media": {
              "markdown": "resources/walkthrough/first-project.md"
            },
            "completionEvents": [
              "onCommand:crew.newProject"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build-extension.mjs",
    "watch": "node scripts/build-extension.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "lint": "eslint . && npm run typecheck",
    "test": "npm run test:unit",
    "test:unit": "vitest run --coverage",
    "pretest:integration": "npm run build && node scripts/build-tests.mjs",
    "test:integration": "vscode-test",
    "package": "node scripts/package.mjs",
    "vscode:prepublish": "node scripts/verify-dist.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.0",
    "@types/vscode": "1.90.0",
    "@vitest/coverage-v8": "^5.0.2",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.0.0",
    "ovsx": "^1.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
