{
  "$comment": "Stack-independent hook policy. A stack profile adds to it from skills/stacks/<profile>/policy.json.",
  "protectedBranches": [
    "main",
    "master"
  ],
  "network": {
    "allowHosts": [
      "localhost",
      "127.0.0.1",
      "::1",
      "0.0.0.0",
      "*.localhost",
      "registry.npmjs.org"
    ]
  },
  "packages": {
    "minAgeDays": 30,
    "minWeeklyDownloads": 1000,
    "registryUrl": "https://registry.npmjs.org",
    "downloadsUrl": "https://api.npmjs.org/downloads/point/last-week",
    "timeoutMs": 5000,
    "allow": []
  },
  "zones": {
    "*": [
      ".crew/tasks/**",
      ".crew/escalations/**"
    ],
    "orchestrator": [
      ".crew/**",
      "docs/**"
    ],
    "pm": [
      ".crew/brief.md",
      ".crew/interview.md",
      ".crew/access-checklist.md"
    ],
    "critic": [
      ".crew/brief.review.md"
    ],
    "architect": [
      ".crew/decisions/**",
      "docs/**",
      ".crew/stack/**",
      ".crew/policy.json"
    ],
    "designer": [
      "docs/design.md",
      "docs/design/**"
    ],
    "keeper": [
      ".crew/status.md",
      ".crew/glossary.md"
    ],
    "security": [
      ".crew/reviews/**"
    ],
    "qa": [
      ".crew/reviews/**",
      "docs/ui-contract.md"
    ],
    "frontend": [],
    "backend": [],
    "db": []
  },
  "safeCommands": [
    [
      "crew"
    ],
    [
      "ls"
    ],
    [
      "cat"
    ],
    [
      "head"
    ],
