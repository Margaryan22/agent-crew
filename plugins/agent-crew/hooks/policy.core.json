      "audit"
    ],
    [
      "npx",
      "tsc"
    ],
    [
      "npx",
      "vitest"
    ],
    [
      "npx",
      "prettier"
    ],
    [
      "npx",
      "eslint"
    ],
    [
      "git",
      "init"
    ],
    [
      "git",
      "status"
    ],
    [
      "git",
      "diff"
    ],
    [
      "git",
      "log"
