    ],
    [
      "grep"
    ],
    [
      "rg"
    ],
    [
      "pwd"
    ],
    [
      "echo"
    ],
    [
      "printf"
    ],
    [
      "test"
    ],
    [
      "true"
    ],
    [
      "sort"
    ],
    [
      "uniq"
    ],
    [
      "diff"
    ],
    [
      "which"
    ],
    [
      "mkdir"
    ],
    [
      "touch"
    ],
    [
      "cp"
    ],
    [
      "mv"
    ],
    [
      "node"
    ],
    [
      "npm",
      "test"
    ],
    [
      "npm",
      "run"
    ],
    [
      "npm",
      "ci"
    ],
    [
      "npm",
