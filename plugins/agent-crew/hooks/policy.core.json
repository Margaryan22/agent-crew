  "projectCommands": {
    "$comment": "Tools a project's own policy (.crew/policy.json) may add safe commands for. A prefix needs a subcommand (\"npm test\"), except for the single-purpose tools in \"alone\".",
    "tools": [
      "npm",
      "npx",
      "pnpm",
      "yarn",
      "bun",
      "bunx",
      "deno",
      "node",
      "python",
      "python3",
      "pip",
      "pip3",
      "uv",
      "poetry",
      "pytest",
      "go",
      "cargo",
      "dotnet",
      "mvn",
      "gradle",
      "./gradlew",
      "php",
      "composer",
      "ruby",
      "bundle",
      "rails",
      "rake",
      "make",
      "mix",
      "swift"
    ],
    "alone": [
      "pytest"
    ]
  },
  "payPerUse": {
    "$comment": "Models billed in usage credits even on a subscription (matched as substrings of the model id). With one of them, or with an API key or cloud provider credentials, the crew reminds the user that no spending cap is set.",
    "models": [
      "fable"
    ]
  },
  "crewCommands": {
    "$comment": "Who may run which state-changing crew command. \"$stage\" means: only the agent named by --stage (qa or security). Commands not listed (show, list, next, check, start, submit, fail, escalate, …) are open to every agent.",
    "init": [
      "orchestrator"
    ],
    "scaffold": [
      "orchestrator"
    ],
    "status set": [
      "orchestrator",
      "keeper"
    ],
    "task new": [
      "orchestrator",
      "architect"
    ],
    "task set": [
      "orchestrator"
    ],
    "task block": [
      "orchestrator"
    ],
    "task pass": [
      "$stage"
    ],
    "task reject": [
      "$stage"
    ],
    "escalation answer": [
      "orchestrator"
    ],
    "escalation resolve": [
      "orchestrator"
    ],
    "escalation cancel": [
      "orchestrator"
    ],
    "decision new": [
      "orchestrator",
      "architect"
    ],
    "interview answer": [
      "orchestrator"
    ],
    "lesson add": [
      "orchestrator"
    ],
    "size set": [
      "orchestrator"
    ],
    "approvals reset": [
      "orchestrator"
    ]
  },
  "prices": {
    "$comment": "USD per million tokens, list prices as of 2026-09-25 — for estimates only. cacheRead defaults to 0.1 x input and cacheWrite to 1.25 x input when absent.",
    "asOf": "2026-09-25",
    "models": {
      "claude-fable-5-1": {
        "input": 10,
        "output": 50,
        "cacheRead": 0.25
      },
      "claude-fable-5": {
        "input": 10,
        "output": 50
      },
      "claude-opus-5-5": {
        "input": 4,
        "output": 20,
        "cacheRead": 0.2
      },
      "claude-opus-5": {
        "input": 5,
        "output": 25
      },
      "claude-opus-4-8": {
        "input": 5,
        "output": 25
      },
      "claude-sonnet-5-5": {
        "input": 2,
        "output": 10,
        "cacheRead": 0.2
      },
      "claude-sonnet-5": {
        "input": 2,
        "output": 10
      },
      "claude-sonnet-4-6": {
        "input": 3,
        "output": 15
      },
      "claude-haiku-4-5": {
        "input": 1,
        "output": 5
      }
    },
    "aliases": {
      "fable": "claude-fable-5-1",
      "opus": "claude-opus-5-5",
      "sonnet": "claude-sonnet-5-5",
      "haiku": "claude-haiku-4-5"
    }
  }
}
