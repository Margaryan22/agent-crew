{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^T-\\d{3,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "status": {
      "type": "string",
      "enum": [
        "todo",
        "in_progress",
        "review",
        "done",
        "blocked"
      ]
    },
    "owner": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "attempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "model": {
      "type": "string",
      "pattern": "^[\\w.:[\\]-]+$"
    },
    "ladder": {
      "type": "string",
      "enum": [
        "retry",
        "stronger_model",
        "replan"
      ]
    },
    "last_error_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^T-\\d{3,}$"
      }
    },
    "review_stage": {
      "type": "string",
      "enum": [
        "qa",
        "security"
      ]
    },
    "escalation": {
      "type": "string",
      "pattern": "^E-\\d{3,}$"
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "base": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "budget_usd": {
      "type": "number",
      "minimum": 0
    },
    "spent_usd_estimate": {
      "type": "number",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "id",
    "title",
    "status",
    "owner",
    "attempts",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": {},
  "$id": "https://github.com/Margaryan22/agent-crew/crew-contract/schemas/task.schema.json",
  "description": "agent-crew .crew/ contract v1: task. Cross-field rules are enforced by the Zod schema in crew-contract/src/schemas.ts."
}
