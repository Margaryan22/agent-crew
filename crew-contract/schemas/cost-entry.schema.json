{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "source": {
      "type": "string",
      "enum": [
        "sdk",
        "headless",
        "estimate",
        "manual"
      ]
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "turn_cost_usd": {
      "type": "number",
      "minimum": 0
    },
    "session_total_usd": {
      "type": "number",
      "minimum": 0
    },
    "task": {
      "type": "string",
      "pattern": "^T-\\d{3,}$"
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "pattern": "^[\\w.:[\\]-]+$"
    },
    "tokens": {
      "type": "object",
      "properties": {
        "input": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cache_read": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cache_write": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "input",
        "output"
      ]
    }
  },
  "required": [
    "ts",
    "source"
  ],
  "additionalProperties": {},
  "$id": "https://github.com/Margaryan22/agent-crew/crew-contract/schemas/cost-entry.schema.json",
  "description": "agent-crew .crew/ contract v1: cost-entry. Cross-field rules are enforced by the Zod schema in crew-contract/src/schemas.ts."
}
