{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "phase": {
      "type": "string",
      "enum": [
        "interview",
        "brief",
        "architecture",
        "acceptance_tests",
        "decomposition",
        "tasks",
        "final",
        "done",
        "stopped",
        "failed"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "active_tasks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^T-\\d{3,}$"
      }
    },
    "stop_reason": {
      "type": "string",
      "enum": [
        "budget_cap",
        "user",
        "error"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 280
    }
  },
  "required": [
    "phase",
    "updated_at"
  ],
  "additionalProperties": {},
  "$id": "https://github.com/Margaryan22/agent-crew/crew-contract/schemas/status.schema.json",
  "description": "agent-crew .crew/ contract v1: status. Cross-field rules are enforced by the Zod schema in crew-contract/src/schemas.ts."
}
