{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "plugin": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "stack_profile": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "size": {
      "type": "string",
      "enum": [
        "prototype",
        "standard"
      ]
    }
  },
  "required": [
    "contract_version",
    "plugin",
    "stack_profile",
    "created_at"
  ],
  "additionalProperties": {},
  "$id": "https://github.com/Margaryan22/agent-crew/crew-contract/schemas/manifest.schema.json",
  "description": "agent-crew .crew/ contract v1: manifest. Cross-field rules are enforced by the Zod schema in crew-contract/src/schemas.ts."
}
