# Everything is excluded unless re-included below: only bundles and resources ship.
**

!package.json
!README.md
!CHANGELOG.md
!LICENSE
!SUPPORT.md

!dist/extension.js
!dist/webview/**
!dist/sdk/**
!dist/bin/**
!resources/**

# Never ship sources, maps, tests or configs.
**/*.ts
**/*.tsx
**/*.map
**/tsconfig*.json
**/.DS_Store

# The plugin ships verbatim — whatever file types its hooks and skills need.
!resources/plugin/**
